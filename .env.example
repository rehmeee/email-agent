# MailMind / Email Agent — copy to `.env` or `.env.local` and fill in real values.
# Never commit real secrets. Sync the same keys to Vercel for Production/Preview.

# --- Auth / cron ---
# Generate: openssl rand -base64 32
AUTH_SECRET=
CRON_SECRET=

# --- App URL (Vercel domain or local/ngrok HTTPS for Drive webhooks) ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional alias used by some Supabase setups (fallback if ANON_KEY unset)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Google OAuth (Cloud Console) + GCP ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CLOUD_PROJECT_ID=
GMAIL_PUBSUB_TOPIC=projects/<project-id>/topics/gmail-push
DRIVE_PUBSUB_TOPIC=projects/<project-id>/topics/drive-push
# Optional override for Drive changes.watch webhook (defaults to NEXT_PUBLIC_APP_URL/api/drive/webhook)
# DRIVE_WEBHOOK_URL=

# --- DeepSeek LLM ---
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_REASONING_EFFORT=high
DEEPSEEK_THINKING=enabled

# --- LangSmith / LangChain (optional tracing) ---
LANGCHAIN_API_KEY=
LANGCHAIN_CALLBACKS_BACKGROUND=true
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=mailmind-dev

# --- Workspace MCP (Gmail/Drive/Calendar tools) ---
# Local Docker/uvx: http://localhost:8000/mcp
WORKSPACE_MCP_URL=

# --- Optional ---
# USER_TIMEZONE=America/New_York
# AUTH_URL=
